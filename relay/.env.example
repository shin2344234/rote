# Copy this file to .env and fill it in. Never commit .env.

# Private repo that receives the issues and the report zips, as owner/name.
GITHUB_REPO=

# Fine-grained GitHub token limited to that repo, with read and write access to Contents and Issues.
GITHUB_TOKEN=

# The existing Docker network your reverse proxy or tunnel container is attached to.
PROXY_NETWORK=

# Leave these out to build the image from this folder. Set both to run the image that
# GitHub Actions publishes, which Watchtower can then keep current.
# IMAGE_NAME=ghcr.io/shin2344234/rote-relay:latest
# PULL_POLICY=always
