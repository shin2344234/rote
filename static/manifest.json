{
  "manifest_version": 3,
  "name": "Rote: job application autofill",
  "short_name": "Rote",
  "version": "0.1.4",
  "description": "Fills job applications from a locally parsed resume. Your profile goes to the AI provider you pick only when you click Review.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["scripting", "storage", "sidePanel", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Rote", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html"
}
